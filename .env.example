# ==============================================================================
# LootPing Configuration & Credentials
# ==============================================================================

# Discord Notification Settings
# Webhook URL created in your Discord Channel Settings -> Integrations -> Webhooks
DISCORD_WEBHOOK_URL=
# Optional: Role ID to ping (e.g. 123456789012345678) or leave empty for no mention
DISCORD_ROLE_ID=

# Telegram Notification Settings
# Create bot via @BotFather on Telegram to get token
TELEGRAM_BOT_TOKEN=
# Target channel (@channel_username) or Chat ID (-100xxxxxxxxx / xxxxxxxxx)
TELEGRAM_CHAT_ID=

# WhatsApp Notification Settings (via CallMeBot Gateway)
# Follow instructions at https://www.callmebot.com/blog/free-api-whatsapp-messages/
# Phone number including country code without + or spaces (e.g., 1234567890)
WHATSAPP_PHONE=
# API key obtained from CallMeBot
WHATSAPP_APIKEY=

# Ingestion Settings
# Giveaway type: 'game' (default), 'loot', 'beta', or 'all'
GIVEAWAY_TYPE=game
# Filter allowed storefronts/platforms (comma-separated, e.g. steam, epic, xbox, playstation, gog, ubisoft, prime)
ALLOWED_PLATFORMS=steam, epic, xbox, playstation, gog, ubisoft, prime
# State cache storage path
STATE_FILE_PATH=data/alerted_ids.json
# Auto-prune alert records older than N days (default: 90)
STATE_PRUNE_DAYS=90
# Enable CheapShark 100% free deal scraping (true/false, default: true)
ENABLE_CHEAPSHARK=true
